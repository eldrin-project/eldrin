# =============================================================================
# Eldrin Parent Repository .gitignore
# =============================================================================
# This .gitignore is for the parent repository that orchestrates all Eldrin
# submodules. Individual submodules have their own .gitignore files.
# =============================================================================

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js

# -----------------------------------------------------------------------------
# Build Outputs
# -----------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
.output/
*.local

# TypeScript
*.tsbuildinfo

# Bun
*.bun-build

# -----------------------------------------------------------------------------
# IDE and Editors
# -----------------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/

# JetBrains IDEs (WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.ipr
*.iws

# Vim
*.swp
*.swo
*~
*.vim
Session.vim
.netrwhist

# Emacs
*~
\#*\#
.#*
*.elc

# Sublime Text
*.sublime-workspace
*.sublime-project

# Visual Studio
*.suo
*.ntvs*
*.njsproj
*.sln
*.vcxproj*

# -----------------------------------------------------------------------------
# Operating System Files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# -----------------------------------------------------------------------------
# Environment and Secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.test
.dev.vars
.dev.vars.*
!.dev.vars.example

# Private/sensitive directories
private/
secrets/

# -----------------------------------------------------------------------------
# Logs and Debug Files
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
testem.log
libpeerconnection.log

# -----------------------------------------------------------------------------
# Test and Coverage
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
__screenshots__/

# -----------------------------------------------------------------------------
# Cloud Platform / Deployment
# -----------------------------------------------------------------------------
# Cloudflare
.wrangler/

# Vercel
.vercel/

# Netlify
.netlify/

# -----------------------------------------------------------------------------
# Framework-specific (for parent-level tooling if any)
# -----------------------------------------------------------------------------
# Angular
.angular/

# SvelteKit
.svelte-kit/

# Sass
.sass-cache/

# -----------------------------------------------------------------------------
# Temporary Files
# -----------------------------------------------------------------------------
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# Specifically exclude react-todo-temp (temporary directory noticed in project)
react-todo-temp/

# -----------------------------------------------------------------------------
# Local-only Example Applications (not submodules)
# -----------------------------------------------------------------------------
# These are local example/demo applications without GitHub remotes.
# They are intentionally NOT tracked in the parent repo.
# Uncomment the lines below if you want to exclude them entirely:
# angular-todo/
# react-todo/
# svelte-todo/
# vue-todo/

# -----------------------------------------------------------------------------
# Miscellaneous
# -----------------------------------------------------------------------------
# Package manager locks (if parent has any)
# Uncomment if you want to ignore lock files at parent level:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
# bun.lockb

# SQL files (local database dumps)
*.sql

# Connection/lock files
connect.lock
typings/

# -----------------------------------------------------------------------------
# Claude Code / AI Assistant
# -----------------------------------------------------------------------------
# Keep .claude directory for AI assistant configuration
# .claude/

.superpowers/

{
  "name": "eldrin-email",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "generate:migrations": "tsx scripts/generate-migrations.ts",
    "dev": "npm run generate:migrations && vite",
    "dev:worker": "npm run generate:migrations && wrangler dev",
    "build": "npm run generate:migrations && tsc -b && vite build",
    "preview": "npm run build && vite preview --port 4010",
    "deploy": "npm run build && wrangler deploy",
    "release": "eldrin-release",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@eldrin-project/eldrin-app-core": "file:../eldrin-app-core",
    "@eldrin-project/eldrin-app-react": "^0.0.2",
    "@tailwindcss/vite": "^4.1.18",
    "daisyui": "^5.0.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.6.0",
    "lucide-react": "^0.562.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "single-spa-react": "^6.0.2",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.18.0",
    "@cloudflare/workers-types": "^4.20251216.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.5.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.7.0",
    "typescript": "~5.9.3",
    "vite": "^6.3.5",
    "vitest": "^2.0.0",
    "wrangler": "^4.16.0"
  }
}

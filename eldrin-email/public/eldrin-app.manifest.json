{
  "id": "eldrin-email",
  "name": "Email",
  "version": "0.0.1",
  "entry": "/eldrin-email.js",
  "styles": "/eldrin-email.css",
  "developer_id": "eldrin.io",
  "developer": {
    "id": "eldrin.io",
    "name": "Eldrin Team"
  },
  "compatibility": {
    "core": ">=0.1.0"
  },
  "permissions": [
    { "resource": "mailboxes", "actions": ["read", "create", "update", "delete"] },
    { "resource": "emails", "actions": ["read", "send", "update"] },
    { "resource": "templates", "actions": ["read", "create", "update", "delete"] },
    { "resource": "tracking", "actions": ["read"] }
  ],
  "groups": [
    {
      "id": "admin",
      "name": "Admin",
      "description": "Full access to all email features including mailbox management",
      "permissions": ["*:*"]
    },
    {
      "id": "user",
      "name": "User",
      "description": "Send and receive email, manage own mailbox and templates",
      "permissions": [
        "mailboxes:read", "mailboxes:create", "mailboxes:update", "mailboxes:delete",
        "emails:read", "emails:send", "emails:update",
        "templates:read", "templates:create", "templates:update", "templates:delete",
        "tracking:read"
      ]
    },
    {
      "id": "viewer",
      "name": "Viewer",
      "description": "Read-only access to emails and templates",
      "permissions": [
        "emails:read",
        "templates:read",
        "tracking:read"
      ]
    }
  ],
  "api": {
    "defaultPolicy": "deny",
    "publicRoutes": [
      "/health",
      "/track/*",
      "/mailbox/connect/*",
      "/mailbox/callback/*",
      "/_events/webhook"
    ],
    "routes": [
      { "method": "POST", "path": "/api/mailbox/connect-token", "permission": "mailboxes:create" },
      { "method": "GET", "path": "/api/mailboxes", "permission": "mailboxes:read" },
      { "method": "PATCH", "path": "/api/mailboxes/:id", "permission": "mailboxes:update" },
      { "method": "DELETE", "path": "/api/mailboxes/:id", "permission": "mailboxes:delete" },
      { "method": "POST", "path": "/api/mailboxes/:id/pause", "permission": "mailboxes:update" },
      { "method": "POST", "path": "/api/mailboxes/:id/resume", "permission": "mailboxes:update" },
      { "method": "POST", "path": "/api/mailboxes/:id/sync", "permission": "mailboxes:read" },
      { "method": "GET", "path": "/api/inbox", "permission": "emails:read" },
      { "method": "GET", "path": "/api/inbox/:threadId", "permission": "emails:read" },
      { "method": "PATCH", "path": "/api/inbox/:threadId", "permission": "emails:update" },
      { "method": "GET", "path": "/api/sent", "permission": "emails:read" },
      { "method": "GET", "path": "/api/email/search", "permission": "emails:read" },
      { "method": "POST", "path": "/api/email/send", "permission": "emails:send" },
      { "method": "POST", "path": "/api/email/send-template", "permission": "emails:send" },
      { "method": "GET", "path": "/api/email/history", "permission": "emails:read" },
      { "method": "GET", "path": "/api/email/history/record", "permission": "emails:read" },
      { "method": "GET", "path": "/api/templates", "permission": "templates:read" },
      { "method": "GET", "path": "/api/templates/:id", "permission": "templates:read" },
      { "method": "POST", "path": "/api/templates", "permission": "templates:create" },
      { "method": "PATCH", "path": "/api/templates/:id", "permission": "templates:update" },
      { "method": "DELETE", "path": "/api/templates/:id", "permission": "templates:delete" },
      { "method": "POST", "path": "/api/templates/:id/preview", "permission": "templates:read" },
      { "method": "POST", "path": "/api/templates/:id/use", "permission": "templates:read" }
    ]
  },
  "database": {
    "name": "eldrin-email-db",
    "migrationsPath": "migrations",
    "handledBy": "worker"
  },
  "ui": {
    "sideNav": [
      { "label": "Inbox", "icon": "inbox", "path": "/eldrin-email" },
      { "label": "Sent", "icon": "send", "path": "/eldrin-email/sent" },
      { "label": "Templates", "icon": "file-text", "path": "/eldrin-email/templates" },
      { "label": "Settings", "icon": "settings", "path": "/eldrin-email/settings" }
    ]
  },
  "settings": {
    "groups": [
      {
        "key": "GOOGLE",
        "label": "Google OAuth",
        "description": "OAuth 2.0 credentials for Gmail integration",
        "fields": [
          { "key": "CLIENT_ID", "label": "Client ID", "type": "string", "storage": "config", "required": true, "description": "Google OAuth 2.0 Client ID", "placeholder": "123456789.apps.googleusercontent.com" },
          { "key": "CLIENT_SECRET", "label": "Client Secret", "type": "string", "storage": "secret", "required": true, "description": "Google OAuth 2.0 Client Secret" }
        ]
      },
      {
        "key": "MICROSOFT",
        "label": "Microsoft OAuth",
        "description": "OAuth 2.0 credentials for Outlook/Microsoft 365 integration",
        "fields": [
          { "key": "CLIENT_ID", "label": "Client ID", "type": "string", "storage": "config", "required": true, "description": "Microsoft Entra application (client) ID", "placeholder": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" },
          { "key": "CLIENT_SECRET", "label": "Client Secret", "type": "string", "storage": "secret", "required": true, "description": "Microsoft Entra client secret value" }
        ]
      }
    ]
  },
  "events": {
    "emits": [
      {
        "type": "email.received",
        "description": "New email synced from provider",
        "payload": { "messageId": "string", "threadId": "string", "from": "string", "to": "string", "subject": "string", "snippet": "string", "bodyText": "string? (plain text, max 4000 chars; null when mailbox sync depth fetches no body)", "receivedAt": "string" }
      },
      {
        "type": "email.sent",
        "description": "Email sent through platform",
        "payload": { "messageId": "string", "from": "string", "to": "string", "subject": "string", "templateId": "string?", "relatedApp": "string?", "relatedRecordId": "string?" }
      },
      {
        "type": "email.opened",
        "description": "Tracking pixel loaded by recipient",
        "payload": { "messageId": "string", "recipientEmail": "string", "openedAt": "string" }
      },
      {
        "type": "email.clicked",
        "description": "Tracked link clicked by recipient",
        "payload": { "messageId": "string", "recipientEmail": "string", "url": "string", "clickedAt": "string" }
      },
      {
        "type": "email.bounced",
        "description": "Email delivery failure",
        "payload": { "messageId": "string", "recipientEmail": "string", "bounceType": "string", "reason": "string" }
      },
      {
        "type": "email.mailbox.connected",
        "description": "New mailbox connected",
        "payload": { "mailboxId": "string", "provider": "string", "emailAddress": "string", "userId": "string" }
      },
      {
        "type": "email.mailbox.disconnected",
        "description": "Mailbox removed",
        "payload": { "mailboxId": "string", "provider": "string", "emailAddress": "string" }
      },
      {
        "type": "email.mailbox.error",
        "description": "Sync error on a mailbox",
        "payload": { "mailboxId": "string", "provider": "string", "errorMessage": "string" }
      }
    ],
    "subscribes": [
      { "pattern": "email.send.requested", "delivery": "push" },
      { "pattern": "user.deleted", "delivery": "push" },
      { "pattern": "*", "delivery": "push" }
    ]
  }
}
